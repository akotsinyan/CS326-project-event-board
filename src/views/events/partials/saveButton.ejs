<div id="save-button-<%= eventId %>" class="w-full">
  <% if (state==="saved" ) { %>
    <form hx-post="/events/<%= eventId %>/save" hx-target="#save-button-<%= eventId %>" hx-swap="outerHTML"
      class="w-full">
      <button type="submit"
        class="w-full px-5 py-3 rounded-xl bg-yellow-500 text-white font-semibold text-center hover:bg-yellow-600 cursor-pointer">
        ⭐ Saved — Click to Remove
      </button>
    </form>
    <p class="text-sm text-slate-500 mt-2 text-center">
      This event is in your saved list.
    </p>
    <% } else { %>
      <form hx-post="/events/<%= eventId %>/save" hx-target="#save-button-<%= eventId %>" hx-swap="outerHTML"
        class="w-full">
        <button type="submit"
          class="w-full px-5 py-3 rounded-xl bg-slate-600 text-white font-semibold text-center hover:bg-slate-700 cursor-pointer">
          📌 Save for Later
        </button>
      </form>
      <p class="text-sm text-slate-500 mt-2 text-center">
        Save this event to your personal list.
      </p>
      <% } %>
</div>