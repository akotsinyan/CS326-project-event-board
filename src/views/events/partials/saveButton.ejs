<div id="save-button-<%= eventId %>" class="w-full">
  <% if (state==="saved" ) { %>
    <form hx-post="/events/<%= eventId %>/save" hx-target="#save-button-<%= eventId %>" hx-swap="outerHTML"
      class="w-full">
      <button type="submit"
        class="w-full px-5 py-3 rounded-xl bg-[#881c1c] text-white font-bold text-center shadow-md shadow-[#881c1c]/20 hover:bg-[#a12a2a] hover:-translate-y-0.5 transition cursor-pointer">
        Saved — Click to Remove
      </button>
    </form>
    <p class="text-sm text-slate-500 mt-2 text-center">
      This event is in your saved list.
    </p>
    <% } else { %>
      <form hx-post="/events/<%= eventId %>/save" hx-target="#save-button-<%= eventId %>" hx-swap="outerHTML"
        class="w-full">
        <button type="submit"
          class="w-full px-5 py-3 rounded-xl bg-white text-[#881c1c] font-semibold text-center border border-[#881c1c]/25 shadow-sm hover:bg-[#881c1c] hover:text-white hover:-translate-y-0.5 transition cursor-pointer">
          Save for Later
        </button>
      </form>
      <p class="text-sm text-slate-500 mt-2 text-center">
        Save this event to your personal list.
      </p>
      <% } %>
</div>