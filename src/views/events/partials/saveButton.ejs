<%# src/views/events/partials/saveButton.ejs %>
<%# Expected locals: state ("saved" | "unsaved"), eventId %>

<div id="save-button-<%= eventId %>">
  <% if (state === "saved") { %>
    <form
      hx-post="/events/<%= eventId %>/save"
      hx-target="#save-button-<%= eventId %>"
      hx-swap="outerHTML"
      class="inline"
    >
      <button
        type="submit"
        class="px-5 py-2.5 rounded-lg bg-yellow-500 text-white font-semibold hover:bg-yellow-600 cursor-pointer"
      >
        ⭐ Saved — Click to Remove
      </button>
    </form>
    <p class="text-sm text-slate-500 mt-1">This event is in your saved list.</p>
  <% } else { %>
    <form
      hx-post="/events/<%= eventId %>/save"
      hx-target="#save-button-<%= eventId %>"
      hx-swap="outerHTML"
      class="inline"
    >
      <button
        type="submit"
        class="px-5 py-2.5 rounded-lg bg-slate-600 text-white font-semibold hover:bg-slate-700 cursor-pointer"
      >
        📌 Save for Later
      </button>
    </form>
    <p class="text-sm text-slate-500 mt-1">Save this event to your personal list.</p>
  <% } %>
</div>
