<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Events</h1>
  <p class="text-slate-500">Browse upcoming events. Use the filters or search to narrow your view.</p>
</section>

<section class="mb-5 p-4 border border-slate-200 rounded-2xl bg-white shadow-sm">
  <form method="GET" action="/events" class="flex flex-wrap items-end gap-4">
    <div>
      <label for="q" class="block text-sm font-semibold text-slate-700 mb-1">Search</label>
      <input
        type="text"
        id="q"
        name="q"
        value="<%= filter.query %>"
        placeholder="Title, description, location…"
        class="px-3 py-2 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 w-56"
      />
    </div>

    <div>
      <label for="category" class="block text-sm font-semibold text-slate-700 mb-1">Category</label>
      <select
        id="category"
        name="category"
        class="px-3 py-2 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="" <%= filter.category === "" ? "selected" : "" %>>All categories</option>
        <option value="tech" <%= filter.category === "tech" ? "selected" : "" %>>Tech</option>
        <option value="careers" <%= filter.category === "careers" ? "selected" : "" %>>Careers</option>
        <option value="social" <%= filter.category === "social" ? "selected" : "" %>>Social</option>
        <option value="academic" <%= filter.category === "academic" ? "selected" : "" %>>Academic</option>
      </select>
    </div>

    <div>
      <label for="timeframe" class="block text-sm font-semibold text-slate-700 mb-1">Timeframe</label>
      <select
        id="timeframe"
        name="timeframe"
        class="px-3 py-2 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="all" <%= filter.timeframe === "all" ? "selected" : "" %>>All upcoming</option>
        <option value="this-week" <%= filter.timeframe === "this-week" ? "selected" : "" %>>This week</option>
        <option value="this-weekend" <%= filter.timeframe === "this-weekend" ? "selected" : "" %>>This weekend</option>
      </select>
    </div>

    <div class="flex gap-2">
      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 cursor-pointer"
      >
        Filter
      </button>
      <% if (filter.query || filter.category || filter.timeframe !== "all") { %>
        <a href="/events" class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 font-semibold hover:bg-slate-200 no-underline">
          Clear
        </a>
      <% } %>
    </div>
  </form>
</section>

<div id="event-list">
  <%- include("./partials/eventList", { events }) %>
</div>
