

<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 mb-1"><%= event.title %></h1>
      <p class="text-slate-500">Organized by <%= event.organizerName %></p>
    </div>
    <% const statusColors = { published: "bg-green-100 text-green-800 border-green-200", draft: "bg-yellow-100 text-yellow-800 border-yellow-200", cancelled: "bg-red-100 text-red-800 border-red-200", past: "bg-slate-100 text-slate-600 border-slate-200" }; %>
    <span id="status-badge" class="inline-block text-xs font-semibold px-3 py-1.5 rounded-full border capitalize <%= statusColors[event.status] || 'bg-slate-100 text-slate-600 border-slate-200' %>">
      <%= event.status %>
    </span>
  </div>
</section>



<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<% if (event.status === "cancelled") { %>
  <div class="mb-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-800">
    <p class="font-semibold">This event has been cancelled.</p>
  </div>
<% } %>

<section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main content -->
  <div class="lg:col-span-2">
    <!-- Event Details Card -->
    <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg mb-6">
      <h2 class="text-lg font-bold text-slate-900 mb-4">Event Details</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Date & Time -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-600 mb-2">Date & Time</p>
      
          <div x-data="relativeEventTime('<%= event.startDatetime.toISOString() %>')" x-init="init()" class="space-y-1">
            <p class="text-slate-900">
              <%= event.startDatetime.toLocaleDateString("en-US", { weekday: "long" , year: "numeric" , month: "long" ,
                day: "numeric" }) %>
                <br />
                <%= event.startDatetime.toLocaleTimeString("en-US", { hour: "numeric" , minute: "2-digit" }) %>
                  &ndash;
                  <%= event.endDatetime.toLocaleTimeString("en-US", { hour: "numeric" , minute: "2-digit" }) %>
            </p>
      
            <p class="text-sm text-slate-500">
              <span class="font-medium text-slate-600">Quick label:</span>
              <span x-text="relativeLabel"></span>
            </p>
          </div>
        </div>
      
        <!-- Location -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-600 mb-2">Location</p>
          <p class="text-slate-900">
            <%= event.location %>
          </p>
        </div>
      
        <!-- Category -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-600 mb-2">Category</p>
          <p
            class="inline-block text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
            <%= event.category %>
          </p>
        </div>
      
        <!-- Capacity / Attendance -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
          <% if (event.capacity !==null) { %>
            <p class="text-sm font-semibold text-slate-600 mb-2">Capacity</p>
            <p class="text-slate-900">
              <%= event.attendeeCount %> / <%= event.capacity %> attendees
                  <span class="text-slate-500 text-sm">(<%= event.capacity - event.attendeeCount %> spots remaining)</span>
            </p>
            <% } else { %>
              <p class="text-sm font-semibold text-slate-600 mb-2">Attendance</p>
              <p class="text-slate-900">
                <%= event.attendeeCount %> attendees (unlimited capacity)
              </p>
              <% } %>
        </div>
      </div>
    </div>

    <!-- Description Card -->
    <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
      <h2 class="text-lg font-bold text-slate-900 mb-4">About This Event</h2>
      <p class="text-slate-700 whitespace-pre-wrap"><%= event.description || "No description provided." %></p>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="lg:col-span-1">
    <!-- Organizer Info -->
    <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg mb-6">
      <h3 class="text-sm font-bold text-slate-900 mb-2">Organizer</h3>
      <p class="text-slate-700"><%= event.organizerName %></p>
    </div>

    <!-- Organizer / Admin Actions -->
    <% if (canEdit || canPublish || canCancel) { %>
      <%- include("./partials/publishingControls", { event, canEdit, canPublish, canCancel, statusBadgeClass: statusColors[event.status] || "bg-slate-100 text-slate-600 border-slate-200" }) %>
    <% } %>

    <!-- RSVP Button -->
    <% if (canRsvp) { %>
      <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg mb-6">
        <%- include("./rsvp-button", { eventId: event.id, rsvpStatus }) %>
        <div
          hx-get="/events/<%= event.id %>/waitlist/position"
          hx-trigger="load"
          hx-swap="outerHTML"
        ></div>
      </div>
    <% } %>

    <% if (canSave) { %>
      <div class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
        <%- include("./partials/saveButton", { eventId: event.id, state: saveState }) %>
      </div>
    <% } %>

    <!-- Back Link -->
    <div class="mt-6">
      <div class="p-5 border border-[#881c1c]/20 rounded-2xl bg-white shadow-lg text-center">
        <a href="/events"
          class="text-lg font-bold text-[#881c1c] no-underline hover:underline hover:text-[#a22a2a] transition">
          ← Back to Events
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("alpine:init", () => {
    Alpine.data("relativeEventTime", (startIso) => ({
      startIso,
      relativeLabel: "",

      init() {
        this.relativeLabel = this.formatRelativeTime(new Date(this.startIso), new Date());
      },

      formatRelativeTime(target, now) {
        const msPerDay = 24 * 60 * 60 * 1000;
        const start = new Date(target);
        const startDay = new Date(start.getFullYear(), start.getMonth(), start.getDate());
        const nowDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const dayDiff = Math.round((startDay - nowDay) / msPerDay);

        if (dayDiff === 0) return "Today";
        if (dayDiff === 1) return "Tomorrow";
        if (dayDiff === -1) return "Yesterday";
        if (dayDiff > 1 && dayDiff <= 7) return `in ${dayDiff} days`;
        if (dayDiff < -1 && dayDiff >= -7) return `${Math.abs(dayDiff)} days ago`;

        const absDiff = Math.abs(dayDiff);
        return dayDiff > 0 ? `in ${absDiff} days` : `${absDiff} days ago`;
      },
    }));
  });
</script>
