<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Past Events Archive</h1>
  <p class="text-slate-500">Browse events that have already ended.</p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<% if (!events || events.length === 0) { %>
  <section class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
    <p class="text-slate-600">No past events yet.</p>
  </section>
<% } else { %>
  <section class="space-y-4">
    <% events.forEach((event) => { %>
      <article class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-slate-900"><%= event.title %></h2>
            <p class="text-slate-500 mt-1"><%= event.description %></p>
          </div>

          <span class="px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-700">
            <%= event.status %>
          </span>
        </div>

        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-slate-700">
          <p><span class="font-semibold">Location:</span> <%= event.location %></p>
          <p><span class="font-semibold">Category:</span> <%= event.category %></p>
          <p><span class="font-semibold">Started:</span> <%= new Date(event.startDatetime).toLocaleString() %></p>
          <p><span class="font-semibold">Ended:</span> <%= new Date(event.endDatetime).toLocaleString() %></p>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>