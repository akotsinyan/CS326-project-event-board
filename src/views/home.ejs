<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Welcome to Event Board</h1>
  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2 mb-0">
      Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.role %>).
    </p>
  <% } %>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <a href="/events" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
    <h2 class="text-lg font-semibold text-slate-900 mb-1">Browse Events</h2>
    <p class="text-slate-500 text-sm">Find and RSVP to upcoming events.</p>
  </a>

  <% if (session.authenticatedUser?.role === "user") { %>
    <a href="/rsvps/dashboard" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
      <h2 class="text-lg font-semibold text-slate-900 mb-1">My RSVPs</h2>
      <p class="text-slate-500 text-sm">View and manage your event registrations.</p>
    </a>
    <a href="/saved" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
      <h2 class="text-lg font-semibold text-slate-900 mb-1">Saved Events</h2>
      <p class="text-slate-500 text-sm">Events you've bookmarked for later.</p>
    </a>
  <% } %>

  <% if (session.authenticatedUser?.role === "staff" || session.authenticatedUser?.role === "admin") { %>
    <a href="/events/new" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
      <h2 class="text-lg font-semibold text-slate-900 mb-1">Create Event</h2>
      <p class="text-slate-500 text-sm">Draft a new event for your community.</p>
    </a>
  <% } %>

  <% if (session.authenticatedUser?.role === "admin") { %>
    <a href="/admin/users" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
      <h2 class="text-lg font-semibold text-slate-900 mb-1">Manage Users</h2>
      <p class="text-slate-500 text-sm">Create and remove user accounts.</p>
    </a>
  <% } %>

  <a href="/events/archive" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg hover:shadow-md no-underline block">
    <h2 class="text-lg font-semibold text-slate-900 mb-1">Past Events</h2>
    <p class="text-slate-500 text-sm">Browse the archive of concluded events.</p>
  </a>
</section>
