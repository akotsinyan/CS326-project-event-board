<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">My RSVPs</h1>
  <p class="text-slate-500">Events you have registered for.</p>
</section>

<%
function formatDate(d) {
  return new Date(d).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
}
function formatTime(d) {
  return new Date(d).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
}
%>

<section class="mb-8">
  <h2 class="text-xl font-bold text-slate-800 mb-3">Upcoming</h2>
  <% if (upcoming.length === 0) { %>
    <p class="text-slate-500 text-sm">You have no upcoming RSVPs.</p>
  <% } else { %>
    <ul class="space-y-3">
      <% for (const entry of upcoming) { %>
        <li class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm flex flex-col gap-1">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <span class="text-lg font-bold text-slate-900"><%= entry.eventTitle %></span>
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                <%= entry.eventCategory %>
              </span>
              <% if (entry.rsvpStatus === "waitlisted") { %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-yellow-50 text-yellow-700 border border-yellow-200">
                  Waitlisted
                </span>
              <% } else { %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-green-50 text-green-700 border border-green-200">
                  Going
                </span>
              <% } %>
            </div>
          </div>
          <p class="text-sm text-slate-500">
            <%= formatDate(entry.eventStartDatetime) %>
            &middot;
            <%= formatTime(entry.eventStartDatetime) %> &ndash; <%= formatTime(entry.eventEndDatetime) %>
          </p>
          <p class="text-sm text-slate-500"><%= entry.eventLocation %></p>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>

<section>
  <h2 class="text-xl font-bold text-slate-800 mb-3">Past &amp; Cancelled</h2>
  <% if (pastOrCancelled.length === 0) { %>
    <p class="text-slate-500 text-sm">Nothing here yet.</p>
  <% } else { %>
    <ul class="space-y-3">
      <% for (const entry of pastOrCancelled) { %>
        <li class="p-5 border border-slate-200 rounded-2xl bg-slate-50 shadow-sm flex flex-col gap-1 opacity-75">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <span class="text-lg font-bold text-slate-600"><%= entry.eventTitle %></span>
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 border border-slate-200">
                <%= entry.eventCategory %>
              </span>
              <% if (entry.rsvpStatus === "cancelled") { %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-50 text-red-600 border border-red-200">
                  Cancelled
                </span>
              <% } else { %>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 border border-slate-200">
                  Past
                </span>
              <% } %>
            </div>
          </div>
          <p class="text-sm text-slate-400">
            <%= formatDate(entry.eventStartDatetime) %>
            &middot;
            <%= formatTime(entry.eventStartDatetime) %> &ndash; <%= formatTime(entry.eventEndDatetime) %>
          </p>
          <p class="text-sm text-slate-400"><%= entry.eventLocation %></p>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
