<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-1">Saved Events</h1>
  <p class="text-slate-500">Your personal collection of events you're interested in.</p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<% if (events.length === 0) { %>
  <div class="text-center py-12">
    <h2 class="text-xl font-semibold text-slate-900 mb-2">No saved events yet</h2>
    <p class="text-slate-500 mb-6">Browse events and save the ones you're interested in.</p>
    <a href="/events" class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 no-underline">
      Browse Events
    </a>
  </div>
<% } else { %>
  <ul class="space-y-3">
    <% for (const event of events) { %>
      <li id="saved-row-<%= event.id %>" class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm flex items-center justify-between gap-4 flex-wrap">
        <div class="flex-1">
          <h3 class="text-lg font-bold text-slate-900"><%= event.title %></h3>
          <p class="text-sm text-slate-500">
            <%= event.startDatetime.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }) %>
            &middot; <%= event.location %>
          </p>
        </div>
        <div class="flex gap-2 items-center">
          <a href="/events/<%= event.id %>" class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold text-sm hover:bg-blue-700 no-underline">
            View
          </a>
          <form
            hx-post="/events/<%= event.id %>/save"
            hx-target="#saved-row-<%= event.id %>"
            hx-swap="outerHTML"
          >
            <button type="submit" class="px-4 py-2 rounded-lg bg-red-100 text-red-700 font-semibold text-sm hover:bg-red-200 border border-red-200 cursor-pointer">
              Remove
            </button>
          </form>
        </div>
      </li>
    <% } %>
  </ul>
<% } %>

<div class="mt-6">
  <a href="/events"
    class="block w-full text-center py-3 rounded-xl border border-[#881c1c]/20 text-[#881c1c] font-semibold text-sm no-underline bg-white hover:bg-[#881c1c] hover:text-white transition">
    ← Back to Events
  </a>
</div>
