generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  draft
  published
  cancelled
  past
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  category    String
  capacity    Int?
  status      Status   @default(draft)
  startDateTime DateTime
  endDateTime DateTime
  organizerId String
  organizerName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  @@id([userId, eventId])
}
