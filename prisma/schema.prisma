generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  draft
  published
  cancelled
  past
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  category    String
  capacity    Int?
  status      Status   @default(draft)
  startDatetime DateTime
  endDatetime   DateTime
  organizerId   String
  organizerName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsvps Rsvp[]
}

model Rsvp {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, userId])
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  @@id([userId, eventId])
}
