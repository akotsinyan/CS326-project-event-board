generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id
  email        String @unique
  displayName  String
  role         String @default("user")
  passwordHash String
}

model Event {
  id            String   @id
  title         String
  description   String
  location      String
  category      String   @default("general")
  capacity      Int?
  status        String   @default("draft")
  startDatetime DateTime
  endDatetime   DateTime
  organizerId   String
  organizerName String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rsvps         Rsvp[]
}

model Rsvp {
  id        String   @id
  eventId   String
  userId    String
  status    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  @@id([userId, eventId])
}
